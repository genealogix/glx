# Assertion Workflow Example
# Demonstrates the two approaches to recording data in GLX:
# 1. Direct property setting (quick data entry)
# 2. Assertion-backed properties (evidence-based research)

# ===========================================================================
# PLACES - Shared by both approaches
# ===========================================================================

places:
  place-united-states:
    name: "United States"
    type: country

  place-massachusetts:
    name: "Massachusetts"
    type: state
    parent: place-united-states

  place-new-york-state:
    name: "New York"
    type: state
    parent: place-united-states

  place-boston:
    name: "Boston"
    type: city
    parent: place-massachusetts

  place-new-york:
    name: "New York"
    type: city
    parent: place-new-york-state

  place-cambridge:
    name: "Cambridge"
    type: city
    parent: place-massachusetts

# ===========================================================================
# APPROACH 1: DIRECT PROPERTY SETTING (Quick Data Entry)
# ===========================================================================
# This approach is ideal for:
# - Initial data entry from known family records
# - Quick capture of information (add evidence later)
# - Situations where the source is well-known but formal documentation isn't needed yet
# - Personal research where you trust your memory/notes

persons:
  # ---------------------------------------------------------------------
  # Person whose primary fields are stored as DIRECT PROPERTIES.
  # The archive also contains a property-level assertion about her middle
  # name further down (assertion-alice-middle-name) to show the two styles
  # coexisting on the same person.
  # ---------------------------------------------------------------------
  person-alice-chen:
    properties:
      name:
        value: "Alice Chen"
        fields:
          given: "Alice"
          surname: "Chen"
      sex: "female"
      occupation: "software engineer"
      residence: "place-cambridge"
    notes: |
      Quick data entry from family records.
      TODO: Add source citations and assertions when time permits.

  # ---------------------------------------------------------------------
  # Person with ASSERTION-BACKED PROPERTIES (full evidence chain)
  # Shows how assertions provide evidence for property values
  # ---------------------------------------------------------------------
  person-robert-chen:
    properties:
      name:
        value: "Robert Chen"
        fields:
          given: "Robert"
          surname: "Chen"
      sex: "male"
      # Temporal occupation (changed over time)
      occupation:
        - value: "accountant"
          date: "FROM 1978 TO 1995"
        - value: "financial advisor"
          date: "FROM 1995 TO 2020"
        - value: "retired"
          date: "FROM 2020"
      # Temporal residence
      residence:
        - value: "place-new-york"
          date: "FROM 1955 TO 1990"
        - value: "place-boston"
          date: "FROM 1990"
    notes: |
      Father of Alice Chen.
      All properties backed by assertions with full evidence chain.

events:
  event-alice-birth:
    type: birth
    date: "1985-06-15"
    place: place-boston
    participants:
      - person: person-alice-chen
        role: subject

  event-robert-birth:
    type: birth
    date: "1955-03-22"
    place: place-new-york
    participants:
      - person: person-robert-chen
        role: subject

relationships:
  # Parent-child relationship between Robert and Alice
  rel-robert-alice-parent-child:
    type: parent_child
    participants:
      - person: person-robert-chen
        role: parent
      - person: person-alice-chen
        role: child

# ===========================================================================
# APPROACH 2: EVIDENCE CHAIN (Sources -> Citations -> Assertions)
# ===========================================================================
# This approach is ideal for:
# - Professional genealogy research
# - Documenting conflicting evidence
# - Providing audit trail for conclusions
# - Collaborative research where others need to verify claims

# ---------------------------------------------------------------------
# REPOSITORIES - Where sources are held
# ---------------------------------------------------------------------

repositories:
  repository-mass-archives:
    name: "Massachusetts State Archives"
    type: archive
    address: "220 Morrissey Boulevard, Boston, MA 02125"
    website: "https://www.sec.state.ma.us/arc/"

  repository-nyc-records:
    name: "NYC Department of Records"
    type: archive
    address: "31 Chambers Street, New York, NY 10007"

# ---------------------------------------------------------------------
# SOURCES - Original documents and records
# ---------------------------------------------------------------------

sources:
  source-mass-birth-records:
    title: "Massachusetts Birth Records Index"
    type: vital_record
    repository: repository-mass-archives

  source-nyc-birth-records:
    title: "New York City Birth Certificates"
    type: vital_record
    repository: repository-nyc-records
    # Evidence Explained classification (see specification source.md). An
    # original certificate filed at the time of birth, recording firsthand
    # knowledge — the primary-information source that wins the birth-year
    # conflict below.
    properties:
      source_nature: original
      information_type: primary

  source-1990-census:
    title: "1990 United States Census"
    type: census

  source-2000-census:
    title: "2000 United States Census"
    type: census

  source-linkedin:
    title: "LinkedIn Profile - Robert Chen"
    type: database
    properties:
      url: "https://www.linkedin.com/in/robert-chen-example"

  source-chen-family-lore:
    title: "Chen family oral history (cousin Sarah)"
    type: oral_history
    # The two Evidence Explained axes are independent: this recorded interview
    # is itself an `original` source (a firsthand recording of Sarah), yet the
    # information it carries about Robert's 1956 birth is `secondary` — Sarah
    # was not present at the birth and is relaying what Grandpa said. Both
    # sources here are `original`; they differ on information_type, which is why
    # the certificate's claim outranks the lore in the conflict resolution.
    properties:
      source_nature: original
      information_type: secondary

# ---------------------------------------------------------------------
# CITATIONS - Specific references within sources
# ---------------------------------------------------------------------

citations:
  citation-alice-birth-cert:
    source: source-mass-birth-records
    properties:
      locator: "Certificate #1985-0615-23456"
      text_from_source: "Alice Chen, born June 15, 1985, Boston, Suffolk County"

  citation-robert-birth-cert:
    source: source-nyc-birth-records
    properties:
      locator: "Certificate #1955-0322-78901"
      text_from_source: "Robert Chen, male, born March 22, 1955, Manhattan"

  citation-1990-census-chen:
    source: source-1990-census
    properties:
      locator: "Suffolk County, MA, ED 25-456, Sheet 12"
      text_from_source: "Chen, Robert, Head, 35, Accountant; Chen, Alice, Daughter, 5"

  citation-2000-census-chen:
    source: source-2000-census
    properties:
      locator: "Suffolk County, MA, Block 2345"
      text_from_source: "Chen, Robert, 45, Financial Advisor, Boston"

  citation-linkedin-career:
    source: source-linkedin
    properties:
      text_from_source: "Financial Advisor at Chen Financial Services (1995-2020)"
      accessed: "2024-01-15"

  # Secondary source that CONFLICTS with the birth certificate on Robert's
  # birth year. Used by assertion-robert-birth-lore below.
  citation-robert-birth-lore:
    source: source-chen-family-lore
    properties:
      text_from_source: "Cousin Sarah: 'Grandpa Robert always said he was a 1956 baby.'"

# ---------------------------------------------------------------------
# ASSERTIONS - Evidence-backed claims about properties
# ---------------------------------------------------------------------
# Assertions link properties to their supporting evidence.
# Multiple assertions can support the same property (corroboration)
# or conflict with each other (disputed evidence).

assertions:
  # --- CONFLICTING EVIDENCE: two assertions disagree on Robert's birth year ---
  # The birth certificate (primary source) and family oral history (secondary,
  # recalled from memory) give DIFFERENT birth years. Both claims are recorded
  # as separate assertions on the SAME property of the SAME event, then resolved:
  # the primary source is marked `proven` and the contradicted recollection
  # `disproven`. This demonstrates GPS element 4 — resolution of conflicting
  # evidence — and keeps the disagreement visible instead of silently dropping
  # the losing value.

  # Winning assertion: primary source resolves the conflict.
  assertion-robert-birth:
    subject:
      event: event-robert-birth
    property: date
    value: "1955-03-22"
    citations:
      - citation-robert-birth-cert
    confidence: high
    status: proven
    notes: |
      Primary source: original birth certificate, March 22, 1955.
      Takes precedence over cousin Sarah's "1956 baby" recollection
      (assertion-robert-birth-lore), which it disproves.

  # Conflicting assertion: secondary source, contradicted by the certificate.
  assertion-robert-birth-lore:
    subject:
      event: event-robert-birth
    property: date
    value: "1956"
    citations:
      - citation-robert-birth-lore
    confidence: low
    status: disproven
    notes: |
      Family oral history (cousin Sarah) places Robert's birth in 1956.
      Contradicted by the birth certificate (assertion-robert-birth); kept
      on record so the conflicting evidence stays visible rather than hidden.

  # --- Robert's occupation history supported by multiple sources ---
  assertion-robert-accountant:
    subject:
      person: person-robert-chen
    property: occupation
    value: "accountant"
    citations:
      - citation-1990-census-chen
    confidence: high
    notes: "Census records show occupation as accountant in 1990"

  assertion-robert-financial-advisor:
    subject:
      person: person-robert-chen
    property: occupation
    value: "financial advisor"
    citations:
      - citation-2000-census-chen
      - citation-linkedin-career
    confidence: high
    status: proven
    notes: "Multiple sources confirm career change to financial advisor in 1995"

  # --- Robert's residence supported by census evidence ---
  assertion-robert-boston-residence:
    subject:
      person: person-robert-chen
    property: residence
    value: "place-boston"
    citations:
      - citation-1990-census-chen
      - citation-2000-census-chen
    confidence: high
    status: speculative
    notes: "Census records confirm Boston residence from at least 1990, but earlier records not yet checked"

  # --- Alice's birth date supported by primary evidence ---
  assertion-alice-birth:
    subject:
      event: event-alice-birth
    property: date
    value: "1985-06-15"
    citations:
      - citation-alice-birth-cert
    confidence: high
    status: proven
    notes: "Primary source: original birth certificate"

  # --- Alice's birth place from same source ---
  assertion-alice-birthplace:
    subject:
      event: event-alice-birth
    property: place
    value: "place-boston"
    citations:
      - citation-alice-birth-cert
    confidence: high

  # --- Alice's possible middle name — family lore, no primary records pulled ---
  # Demonstrates `status: unresearched`: a lead captured from an indirect source
  # so it isn't lost, with no primary-record search yet performed.
  assertion-alice-middle-name:
    subject:
      person: person-alice-chen
    property: name
    value: "Alice Marie Chen"
    sources:
      - source-chen-family-lore
    confidence: low
    status: unresearched
    notes: "Cousin Sarah's recollection; no birth, baptism, or census records pulled to verify a middle name."

  # --- EXISTENTIAL ASSERTION: relationship exists, evidenced by census ---
  # No property or participant — this simply asserts the relationship exists,
  # backed by source evidence. Adding a date scopes it to a specific time.
  assertion-robert-alice-parentage:
    subject:
      relationship: rel-robert-alice-parent-child
    date: "1990"
    citations:
      - citation-1990-census-chen
    confidence: high
    notes: "1990 census lists Robert Chen as head of household with Alice Chen (age 5) as daughter"

# ===========================================================================
# COMPARISON: Properties With vs Without Assertions
# ===========================================================================
#
# person-alice-chen has:
#   - Properties set directly (quick data entry)
#   - Assertions added AFTER initial entry (best practice)
#   - Shows iterative workflow: enter data first, document evidence later
#
# person-robert-chen has:
#   - Properties and assertions created together
#   - Full evidence chain from the start
#   - Shows rigorous research methodology
#
# rel-robert-alice-parent-child has:
#   - An EXISTENTIAL assertion (no property or participant)
#   - The assertion simply says "this relationship is evidenced by this source"
#   - Adding `date` scopes existence to a specific time ("existed in 1990")
#   - Useful for relationships, events, and places where you want to document
#     that the entity exists without asserting any specific property value
#
# BOTH approaches are valid! The choice depends on:
#   - Time available for documentation
#   - Research context (personal vs. professional)
#   - Collaboration needs (solo vs. team)
#   - Evidence complexity (straightforward vs. conflicting)
#
# The `status` field tracks research state independently of `confidence`:
#   - status: proven       — verified through primary evidence
#   - status: speculative  — hypothesis that needs further research
#   - status: disproven    — evidence contradicts this assertion
#   - status: unresearched — no search has been conducted yet (research gap)
#   - confidence: high     — how certain you are about the claim
#
# A `confidence: high` + `status: speculative` assertion means
# "I'm fairly sure this is right, but I haven't verified it yet."
# A `status: unresearched` assertion means
# "I captured this lead, but I haven't actually searched for evidence yet."
#
# ===========================================================================
