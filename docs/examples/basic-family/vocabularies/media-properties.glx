# Standard Media Properties
# This file defines the standard properties for media entities.
# These properties describe characteristics of media objects (photos, documents, audio, video).
# Archives can extend this with custom properties by adding additional entries.

media_properties:
  description:
    label: "Media Description"
    description: "Detailed description of the media content"
    value_type: string

  subjects:
    label: "Subjects"
    description: "People depicted in the media"
    reference_type: persons
    multi_value: true

  width:
    label: "Width"
    description: "Width in pixels (for images and video)"
    value_type: integer

  height:
    label: "Height"
    description: "Height in pixels (for images and video)"
    value_type: integer

  duration:
    label: "Duration"
    description: "Duration in seconds (for audio and video)"
    value_type: integer

  file_size:
    label: "File Size"
    description: "File size in bytes"
    value_type: integer

  crop:
    label: "Crop"
    description: "Crop coordinates for displaying a region of the media"
    value_type: integer
    gedcom: "CROP"
    fields:
      top:
        label: "Top"
        description: "Top edge position in pixels"
        value_type: integer
      left:
        label: "Left"
        description: "Left edge position in pixels"
        value_type: integer
      width:
        label: "Width"
        description: "Crop region width in pixels"
        value_type: integer
      height:
        label: "Height"
        description: "Crop region height in pixels"
        value_type: integer

  medium:
    label: "Medium"
    description: "Physical medium type (e.g., photograph, document, film)"
    value_type: string
    gedcom: "MEDI"

  original_filename:
    label: "Original Filename"
    description: "Original filename before import or renaming. glx export writes it as _ORIG under FILE, and glx import reads it back, so a GEDCOM round trip keeps it."
    value_type: string

  source_path:
    label: "Source Path"
    description: "The media file's path as the imported GEDCOM's FILE reference wrote it, relative to the GEDCOM file (or the GEDZIP root). Recorded only by glx import --media-source-paths, because folder names can be private."
    value_type: string

  external_ids:
    label: "External Identifiers"
    description: "Identifiers from external systems, such as Ancestry's media object id (_OID)"
    value_type: string
    multi_value: true
    gedcom: "EXID"
    fields:
      type:
        label: "Identifier Type"
        description: "Authority or system that issued this identifier: ancestry for an Ancestry _OID, ancestry_clone for the _OID in an Ancestry _CLON block, or a GEDCOM 7 EXID.TYPE URI."

  photographer:
    label: "Photographer"
    description: "Person who created the media (photographer, videographer, etc.)"
    reference_type: persons

  location:
    label: "Location"
    description: "Place where the media was created"
    reference_type: places

  blob_size:
    label: "BLOB Size"
    description: "Length in bytes of the encoded BLOB text imported from GEDCOM 5.5.1 BLOB records, as the BLOB/CONT lines joined with newlines (pre-decode; includes the line separators, and is not the decoded file size)"
    value_type: integer
