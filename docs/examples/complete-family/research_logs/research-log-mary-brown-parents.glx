research_logs:
  research-log-mary-brown-parents:
    title: "Mary Brown — parentage"
    subject:
      person: person-mary-brown-1852
    objective: "Identify the parents of Mary Brown (born about 1852, married John Smith in Leeds in 1875)."
    status: in_progress
    date: "2026-04-20"
    researcher: "Demo Researcher"
    searches:
      - date: "2026-04-20"
        repository: repository-leeds-library
        source: source-parish-leeds
        query: "Brown baptisms 1851-1853, St Paul's parish"
        result: inconclusive
        notes: "Two Mary Brown baptisms in range: one to Thomas and Ann Brown (weaver), one to William and Sarah Brown (labourer)."
      - repository: repository-tna
        source: source-census-1851
        query: "Brown households with an infant Mary, Leeds, 1851 census"
        result: not_searched
    leads:
      - description: "Daughter of Thomas and Ann Brown, weaver, of Leeds"
        status: active
        confidence: medium
        evidence_for:
          - "Baptism of a Mary Brown, April 1852, St Paul's, a month after her recorded birth date"
        next_steps:
          - "Find the Thomas Brown household in the 1861 census and check for a daughter Mary aged 9"
      - description: "Daughter of William and Sarah Brown, labourer, of Leeds"
        status: eliminated
        confidence: low
        evidence_against:
          - "This Mary Brown was buried in 1854, aged 2 (St Paul's burial register)"
    notes: "The 1875 marriage entry does not name the bride's father, so baptism and census records must carry the identification."
