{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "glx": "https://glx.genealogix.dev/ns/v1#",
    "id": "@id",
    "type": "@type",
    "graph": "@graph",

    "Person": "schema:Person",
    "Event": "schema:Event",
    "Place": "schema:Place",
    "GeoCoordinates": "schema:GeoCoordinates",
    "CreativeWork": "schema:CreativeWork",
    "ArchiveOrganization": "schema:ArchiveOrganization",
    "MediaObject": "schema:MediaObject",
    "PostalAddress": "schema:PostalAddress",

    "Citation": "glx:Citation",
    "Relationship": "glx:Relationship",
    "Assertion": "glx:Assertion",
    "Participation": "glx:Participation",
    "VocabularyEntry": "glx:VocabularyEntry",

    "name": "schema:name",
    "givenName": "schema:givenName",
    "familyName": "schema:familyName",
    "additionalName": "schema:additionalName",
    "honorificPrefix": "schema:honorificPrefix",
    "honorificSuffix": "schema:honorificSuffix",
    "gender": "schema:gender",
    "hasOccupation": "schema:hasOccupation",
    "homeLocation": "schema:homeLocation",

    "containedInPlace": { "@id": "schema:containedInPlace", "@type": "@id" },
    "geo": "schema:geo",
    "latitude": "schema:latitude",
    "longitude": "schema:longitude",

    "address": "schema:address",
    "addressLocality": "schema:addressLocality",
    "addressRegion": "schema:addressRegion",
    "postalCode": "schema:postalCode",
    "addressCountry": "schema:addressCountry",
    "streetAddress": "schema:streetAddress",
    "url": "schema:url",

    "author": "schema:author",
    "datePublished": "schema:datePublished",
    "inLanguage": "schema:inLanguage",
    "description": "schema:description",
    "encodingFormat": "schema:encodingFormat",
    "contentUrl": "schema:contentUrl",
    "associatedMedia": { "@id": "schema:associatedMedia", "@type": "@id" },

    "location": { "@id": "schema:location", "@type": "@id" },
    "startDate": "schema:startDate",
    "endDate": "schema:endDate",

    "subject": { "@id": "glx:subject", "@type": "@id" },
    "role": "glx:role",
    "confidence": "glx:confidence",
    "source": { "@id": "glx:source", "@type": "@id" },
    "citation": { "@id": "glx:citation", "@type": "@id" },
    "person": { "@id": "glx:person", "@type": "@id" },
    "participant": "glx:participant",

    "relationshipType": "glx:relationshipType",
    "eventType": "glx:eventType",
    "placeType": "glx:placeType",
    "sourceType": "glx:sourceType",
    "repositoryType": "glx:repositoryType",
    "mediaType": "glx:mediaType",

    "title": "schema:name",
    "hash": "glx:hash",
    "mimeType": "schema:encodingFormat",
    "value": "schema:value",
    "property": "glx:property",
    "status": "glx:status",
    "sources": { "@id": "glx:sources", "@type": "@id" },
    "citations": { "@id": "glx:citations", "@type": "@id" },
    "media": { "@id": "glx:media", "@type": "@id" },
    "participants": "glx:participants",
    "startEvent": { "@id": "glx:startEvent", "@type": "@id" },
    "endEvent": { "@id": "glx:endEvent", "@type": "@id" },
    "repository": { "@id": "glx:repository", "@type": "@id" },
    "notes": "glx:notes"
  }
}
