{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/genealogix/glx/main/specification/schema/v1/vocabularies/person-statuses.schema.json",
  "title": "Person Statuses Vocabulary",
  "description": "Defines the research placeholder states of a person",
  "type": "object",
  "required": ["person_statuses"],
  "properties": {
    "person_statuses": {
      "type": "object",
      "description": "Map of person status definitions",
      "additionalProperties": {
        "$ref": "#/$defs/PersonStatusDefinition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PersonStatusDefinition": {
      "type": "object",
      "description": "Definition of a single person status",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable label for the status"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the status"
        }
      }
    }
  }
}
