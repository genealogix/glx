{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/genealogix/glx/main/specification/schema/v1/vocabularies/lead-statuses.schema.json",
  "title": "Lead Statuses Vocabulary",
  "description": "Defines the states of a lead (competing hypothesis) inside a ResearchLog",
  "type": "object",
  "required": ["lead_statuses"],
  "properties": {
    "lead_statuses": {
      "type": "object",
      "description": "Map of lead status definitions",
      "additionalProperties": {
        "$ref": "#/$defs/LeadStatusDefinition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "LeadStatusDefinition": {
      "type": "object",
      "description": "Definition of a single lead status",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable label for the status"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the status"
        }
      }
    }
  }
}
