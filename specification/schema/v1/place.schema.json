{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/genealogix/glx/main/specification/schema/v1/place.schema.json",
  "title": "Place",
  "description": "A geographical location. ID comes from the map key in the parent structure.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Primary name of the place"
    },
    "properties": {
      "type": "object",
      "description": "Vocabulary-defined properties of the place",
      "additionalProperties": true
    },
    "parent": {
      "description": "Reference to the parent place in the hierarchy: a place ID, or, when the place's jurisdiction changed over time, a list of {value, date} entries giving the parent for each period",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,64}$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value"],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9-]{1,64}$",
                "description": "Reference to the parent place during this period"
              },
              "date": {
                "type": "string",
                "description": "Period the parent applied (e.g., 'FROM 1811 TO 1816-12-10'); an entry without a date is the default parent"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Type of geographic location (validated against place_types vocabulary)"
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "WGS84 latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "WGS84 longitude coordinate"
    },
    "notes": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ],
      "description": "Free-form notes about the place"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "latitude": ["longitude"],
    "longitude": ["latitude"]
  }
}




