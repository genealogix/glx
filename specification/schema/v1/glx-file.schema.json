{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/genealogix/glx/main/specification/schema/v1/glx-file.schema.json",
  "title": "GENEALOGIX File",
  "description": "A GENEALOGIX file can contain any combination of entities, vocabularies, and property definitions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Import metadata from GEDCOM HEAD/SUBM records",
      "additionalProperties": false,
      "properties": {
        "export_date": { "type": "string" },
        "source_file": { "type": "string" },
        "copyright": { "type": "string" },
        "language": { "type": "string" },
        "source_system": { "type": "string" },
        "source_version": { "type": "string" },
        "source_corporation": { "type": "string" },
        "gedcom_version": { "type": "string" },
        "character_set": { "type": "string" },
        "notes": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ],
          "description": "Free-form notes. Either a single string or an array of strings."
        },
        "submitter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "address": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string" },
            "website": { "type": "string" }
          }
        }
      }
    },
    "persons": {
      "type": "object",
      "description": "Map of person entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "person.schema.json" }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "description": "Map of event entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "event.schema.json" }
      },
      "additionalProperties": false
    },
    "relationships": {
      "type": "object",
      "description": "Map of relationship entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "relationship.schema.json" }
      },
      "additionalProperties": false
    },
    "places": {
      "type": "object",
      "description": "Map of place entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "place.schema.json" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "description": "Map of source entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "source.schema.json" }
      },
      "additionalProperties": false
    },
    "citations": {
      "type": "object",
      "description": "Map of citation entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "citation.schema.json" }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "object",
      "description": "Map of repository entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "repository.schema.json" }
      },
      "additionalProperties": false
    },
    "assertions": {
      "type": "object",
      "description": "Map of assertion entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "assertion.schema.json" }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "description": "Map of media entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "media.schema.json" }
      },
      "additionalProperties": false
    },
    "research_logs": {
      "type": "object",
      "description": "Map of research log entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "research-log.schema.json" }
      },
      "additionalProperties": false
    },
    "studies": {
      "type": "object",
      "description": "Map of study entities",
      "patternProperties": {
        "^[a-zA-Z0-9-]{1,64}$": { "$ref": "study.schema.json" }
      },
      "additionalProperties": false
    },
    "event_types": {
      "type": "object",
      "description": "Event type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/event-types.schema.json#/definitions/EventTypeDefinition" }
      },
      "additionalProperties": false
    },
    "relationship_types": {
      "type": "object",
      "description": "Relationship type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/relationship-types.schema.json#/definitions/RelationshipTypeDefinition" }
      },
      "additionalProperties": false
    },
    "place_types": {
      "type": "object",
      "description": "Place type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/place-types.schema.json#/definitions/PlaceTypeDefinition" }
      },
      "additionalProperties": false
    },
    "repository_types": {
      "type": "object",
      "description": "Repository type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/repository-types.schema.json#/definitions/RepositoryTypeDefinition" }
      },
      "additionalProperties": false
    },
    "participant_roles": {
      "type": "object",
      "description": "Participant role vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/participant-roles.schema.json#/definitions/ParticipantRoleDefinition" }
      },
      "additionalProperties": false
    },
    "media_types": {
      "type": "object",
      "description": "Media type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/media-types.schema.json#/definitions/MediaTypeDefinition" }
      },
      "additionalProperties": false
    },
    "confidence_levels": {
      "type": "object",
      "description": "Confidence level vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/confidence-levels.schema.json#/definitions/ConfidenceLevelDefinition" }
      },
      "additionalProperties": false
    },
    "source_types": {
      "type": "object",
      "description": "Source type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/source-types.schema.json#/definitions/SourceTypeDefinition" }
      },
      "additionalProperties": false
    },
    "sex_types": {
      "type": "object",
      "description": "Sex type vocabulary (as recorded in source documents)",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/sex-types.schema.json#/definitions/SexTypeDefinition" }
      },
      "additionalProperties": false
    },
    "gender_types": {
      "type": "object",
      "description": "Gender identity vocabulary (self-identified; no direct GEDCOM mapping)",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/gender-types.schema.json#/definitions/GenderTypeDefinition" }
      },
      "additionalProperties": false
    },
    "study_types": {
      "type": "object",
      "description": "Study type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/study-types.schema.json#/definitions/StudyTypeDefinition" }
      },
      "additionalProperties": false
    },
    "study_statuses": {
      "type": "object",
      "description": "Study status vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/study-statuses.schema.json#/definitions/StudyStatusDefinition" }
      },
      "additionalProperties": false
    },
    "legal_statuses": {
      "type": "object",
      "description": "Legal-status vocabulary (forms of coerced labor; primarily for the enslavement relationship type)",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/legal-statuses.schema.json#/definitions/LegalStatusDefinition" }
      },
      "additionalProperties": false
    },
    "person_properties": {
      "type": "object",
      "description": "Person property vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/person-properties.schema.json#/definitions/PropertyDefinition" }
      },
      "additionalProperties": false
    },
    "event_properties": {
      "type": "object",
      "description": "Event property vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/event-properties.schema.json#/definitions/PropertyDefinition" }
      },
      "additionalProperties": false
    },
    "relationship_properties": {
      "type": "object",
      "description": "Relationship property vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/relationship-properties.schema.json#/definitions/PropertyDefinition" }
      },
      "additionalProperties": false
    },
    "place_properties": {
      "type": "object",
      "description": "Place property vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/place-properties.schema.json#/definitions/PropertyDefinition" }
      },
      "additionalProperties": false
    },
    "media_properties": {
      "type": "object",
      "description": "Media property vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/media-properties.schema.json#/definitions/PropertyDefinition" }
      },
      "additionalProperties": false
    },
    "repository_properties": {
      "type": "object",
      "description": "Repository property vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/repository-properties.schema.json#/definitions/PropertyDefinition" }
      },
      "additionalProperties": false
    },
    "citation_properties": {
      "type": "object",
      "description": "Citation property vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/citation-properties.schema.json#/definitions/PropertyDefinition" }
      },
      "additionalProperties": false
    },
    "source_properties": {
      "type": "object",
      "description": "Source property vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/source-properties.schema.json#/definitions/PropertyDefinition" }
      },
      "additionalProperties": false
    },
    "search_result_types": {
      "type": "object",
      "description": "Search result type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/search-result-types.schema.json#/definitions/SearchResultTypeDefinition" }
      },
      "additionalProperties": false
    },
    "research_log_status_types": {
      "type": "object",
      "description": "Research log status type vocabulary",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "vocabularies/research-log-status-types.schema.json#/definitions/ResearchLogStatusTypeDefinition" }
      },
      "additionalProperties": false
    }
  }
}

