# Standard Source Properties
# This file defines the standard properties for source entities.
# These properties capture metadata from GEDCOM imports and provide
# structured fields for source-specific information.
# Archives can extend this with custom properties by adding additional entries.

source_properties:
  description:
    label: "Source Description"
    description: "Detailed description of the source content and scope"
    value_type: string

  abbreviation:
    label: "Abbreviation"
    description: "Short reference name used in citations when the source's full title is too long to repeat"
    value_type: string
    gedcom: "ABBR"

  call_number:
    label: "Call Number"
    description: "Repository catalog identifier used to locate this source within a specific archive or library, such as a shelf mark or accession number"
    value_type: string
    gedcom: "CALN"

  events_recorded:
    label: "Events Recorded"
    description: "Types of life events documented by this source, such as births, marriages, or deaths"
    value_type: string
    multi_value: true
    gedcom: "EVEN"

  agency:
    label: "Responsible Agency"
    description: "Organization responsible for creating or maintaining this source, such as a government office, church, or archive"
    value_type: string
    gedcom: "AGNC"

  coverage:
    label: "Coverage"
    description: "Geographic or temporal scope of source content"
    value_type: string

  external_ids:
    label: "External Identifiers"
    description: "Identifiers from external systems (e.g., FamilySearch, Ancestry)"
    value_type: string
    multi_value: true
    gedcom: "EXID"
    fields:
      type:
        label: "Identifier Type"
        description: "Authority or system that issued this identifier (e.g., familysearch, ancestry, wikitree). Often a URI, especially when imported from GEDCOM 7 EXID.TYPE."

  publication_info:
    label: "Publication Information"
    description: "Publication details for the source, including publisher, place of publication, date, and edition"
    value_type: string
    gedcom: "PUBL"

  url:
    label: "URL"
    description: "Web address for the source collection or database. For URLs to specific records within the source, use the citation url property instead."
    value_type: string
