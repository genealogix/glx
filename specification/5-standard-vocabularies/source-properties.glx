# Standard Source Properties
# This file defines the standard properties for source entities.
# These properties capture metadata from GEDCOM imports and provide
# structured fields for source-specific information.
# Archives can extend this with custom properties by adding additional entries.

source_properties:
  description:
    label: "Source Description"
    description: "Detailed description of the source content and scope"
    value_type: string

  abbreviation:
    label: "Abbreviation"
    description: "Short reference name or title for the source (from GEDCOM ABBR tag)"
    value_type: string
    gedcom: "ABBR"

  call_number:
    label: "Call Number"
    description: "Repository catalog or call number where this source is held (from GEDCOM CALN tag)"
    value_type: string
    gedcom: "CALN"

  events_recorded:
    label: "Events Recorded"
    description: "Types of events this source documents (e.g., births, marriages, deaths) (from GEDCOM EVEN tag)"
    value_type: string
    multi_value: true
    gedcom: "EVEN"

  agency:
    label: "Responsible Agency"
    description: "Agency or organization responsible for creating or maintaining this source (from GEDCOM AGNC tag)"
    value_type: string
    gedcom: "AGNC"

  coverage:
    label: "Coverage"
    description: "Geographic or temporal scope of source content"
    value_type: string

  external_ids:
    label: "External Identifiers"
    description: "Identifiers from external systems (e.g., FamilySearch, Ancestry)"
    value_type: string
    multi_value: true
    gedcom: "EXID"
    fields:
      type:
        label: "Identifier Type"
        description: "Authority or system that issued this identifier (e.g., familysearch, ancestry, wikitree). Often a URI, especially when imported from GEDCOM 7 EXID.TYPE."

  publication_info:
    label: "Publication Information"
    description: "Publication details including publisher, place, date, and edition (from GEDCOM PUBL tag)"
    value_type: string
    gedcom: "PUBL"

  url:
    label: "URL"
    description: "Web address for the source collection or database. For URLs to specific records within the source, use the citation url property instead."
    value_type: string

  source_nature:
    label: "Source Nature"
    description: |
      Evidence Explained classification of how this source was produced
      relative to the event it documents: original, derivative, or authored.
      Values are validated against the source_natures vocabulary; archives may
      extend that vocabulary with custom values.
    vocabulary_type: source_natures

  information_type:
    label: "Information Type"
    description: |
      Evidence Explained classification of the information this source conveys,
      by the informant's relationship to the event: primary, secondary, or
      indeterminate. A single source may carry both primary and secondary
      information; at the source level this records the predominant or default
      quality, with fact-level variation expressed per item. Values are
      validated against the information_types vocabulary; archives may extend it
      with custom values.
    vocabulary_type: information_types
