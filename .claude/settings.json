{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go env:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go fix:*)",
      "Bash(go mod why:*)",
      "Bash(go mod graph:*)",
      "Bash(go mod download:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint config verify:*)",
      "Bash(golangci-lint run:*)",
      "Bash(./bin/glx:*)",
      "Bash(make help:*)",
      "Bash(make check:*)",
      "Bash(make build:*)",
      "Bash(make build-cli:*)",
      "Bash(make build-website:*)",
      "Bash(make test:*)",
      "Bash(make test-verbose:*)",
      "Bash(make test-race:*)",
      "Bash(make test-coverage:*)",
      "Bash(make bench:*)",
      "Bash(make lint:*)",
      "Bash(make lint-fix:*)",
      "Bash(make fmt:*)",
      "Bash(make fix:*)",
      "Bash(make fix-diff:*)",
      "Bash(make tidy-check:*)",
      "Bash(make mod-verify:*)",
      "Bash(make mod-tidy:*)",
      "Bash(make check-schemas:*)",
      "Bash(make check-links:*)",
      "Bash(make validate-examples:*)",
      "Bash(make docs-cli:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh search issues:*)",
      "Bash(gh api graphql:*)",
      "Bash(gh api repos/genealogix/glx:*)",
      "Bash(mktemp -d /tmp/glx-drift-*:*)",
      "Bash(rm -rf /tmp/glx-drift-*:*)",
      "Bash(date -u:*)",
      "Bash(tree:*)",
      "Bash(gofmt:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_WORKING_DIRECTORY:-.}\" && STAGED_GO=$(git diff --cached --name-only --diff-filter=ACMR -- \"*.go\" | head -1) && if [ -n \"$STAGED_GO\" ]; then UNSTAGED_GO=$(git diff --name-only -- \"*.go\" | head -1) && if [ -n \"$UNSTAGED_GO\" ]; then echo \"Warning: unstaged Go changes detected — lint may flag code not in this commit\" >&2; fi && BASE=$(git merge-base HEAD main 2>/dev/null || echo HEAD~1) && golangci-lint run --new-from-rev=\"$BASE\" --timeout=5m 2>&1; fi'"
          }
        ]
      },
      {
        "matcher": "Bash(gh api*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-${CLAUDE_WORKING_DIRECTORY:-.}}\" 2>/dev/null; bash scripts/claude-hooks/gh-api-gate.sh || exit 2'"
          }
        ]
      }
    ]
  }
}
