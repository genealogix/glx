{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go env:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go fix:*)",
      "Bash(go mod why:*)",
      "Bash(go mod graph:*)",
      "Bash(go mod download:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint config verify:*)",
      "Bash(golangci-lint run:*)",
      "Bash(./bin/glx:*)",
      "Bash(make help:*)",
      "Bash(make check:*)",
      "Bash(make build:*)",
      "Bash(make build-cli:*)",
      "Bash(make build-website:*)",
      "Bash(make test:*)",
      "Bash(make test-verbose:*)",
      "Bash(make test-race:*)",
      "Bash(make test-coverage:*)",
      "Bash(make bench:*)",
      "Bash(make lint:*)",
      "Bash(make lint-fix:*)",
      "Bash(make fmt:*)",
      "Bash(make fix:*)",
      "Bash(make fix-diff:*)",
      "Bash(make tidy-check:*)",
      "Bash(make mod-verify:*)",
      "Bash(make mod-tidy:*)",
      "Bash(make check-schemas:*)",
      "Bash(make check-links:*)",
      "Bash(make validate-examples:*)",
      "Bash(make docs-cli:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh search issues:*)",
      "Bash(gh api graphql:*)",
      "Bash(gh api repos/genealogix/glx:*)",
      "Bash(mktemp -d /tmp/glx-drift-*:*)",
      "Bash(rm -rf /tmp/glx-drift-*:*)",
      "Bash(date -u:*)",
      "Bash(tree:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "bash -c 'bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/claude-hooks/pre-commit-golangci.sh\"'"
          },
          {
            "type": "command",
            "if": "Bash(gh api:*)",
            "command": "bash -c 'bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/claude-hooks/gh-api-gate.sh\" || exit 2'"
          }
        ]
      }
    ]
  }
}
