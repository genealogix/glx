# Invalid: participant.person references non-existent person
# This should fail validation - broken reference

persons:
  person-mary:
    properties:
      name:
        value: "Mary Brown"
        fields:
          given: "Mary"
          surname: "Brown"

events:
  event-marriage:
    type: marriage
    participants:
      - person: person-mary
        role: bride

sources:
  source-cert:
    title: "Certificate"

citations:
  citation-cert:
    source: source-cert

# This is INVALID - person-nonexistent does not exist
assertions:
  assertion-invalid:
    subject:
      event: event-marriage
    participant:
      person: person-nonexistent  # ERROR: this person doesn't exist
      role: groom
    citations:
      - citation-cert
    confidence: high

# Only the vocabulary entries this fixture uses, so the one error it is about
# is the only error it produces.
event_types:
  marriage:
    label: "Marriage"
    description: "Marriage ceremony"
    category: "lifecycle"

participant_roles:
  groom:
    label: "Groom"
    description: "Male marriage participant"
    applies_to:
      - event
  bride:
    label: "Bride"
    description: "Female marriage participant"
    applies_to:
      - event

confidence_levels:
  high:
    label: "High Confidence"
    description: "Multiple high-quality sources agree, minimal uncertainty"
    rank: 3
