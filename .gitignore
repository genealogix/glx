# GENEALOGIX Repository

# Go build artifacts
bin/
dist/
*.exe
*.test
# Stray CLI binary from building inside the source dir (e.g. `cd glx && go build`).
# Canonical output is bin/glx (see Makefile); this prevents re-committing the binary.
/glx/glx

# Go profiling, coverage, and benchmarks
coverage/
coverage.out
coverage*.html
coverage*.out
bench.txt
*.prof
*.pprof
/cpu.out
/mem.out

# Go module cache artifacts
*.tmp
*.bak

# Python (e.g. scripts/claude-hooks/ bytecode)
__pycache__/
*.pyc

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VitePress build output
website/.vitepress/dist
website/.vitepress/cache

# Generated by website/scripts/copy-static.mjs at build/dev time. The schema
# files live under specification/schema/; they're copied here so the relative
# links from rendered entity spec pages resolve to a static asset.
public/specification/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Environment and secrets
.env
.env.*
!.env.example

# Claude Code local settings (user-specific overrides)
.claude/settings.local.json

# Internal working files
docs/superpowers/
test-import/

# OS generated files
.DS_Store
._*
Thumbs.db
.playwright-mcp/
