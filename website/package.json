{
  "name": "genealogix-docs",
  "version": "0.0.0-beta.12",
  "description": "GENEALOGIX Specification Documentation Site",
  "scripts": {
    "dev": "npm run copy-static && vitepress dev -v --host 0.0.0.0",
    "build": "npm run copy-static && vitepress build",
    "preview": "vitepress preview",
    "copy-static": "node scripts/copy-static.mjs",
    "build:converter": "node scripts/build-converter.mjs",
    "test:converter": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,vue,json,md}\"",
    "postinstall": "node scripts/patch-picomatch.mjs",
    "test:security": "node --test scripts/picomatch-security.test.mjs"
  },
  "keywords": [
    "genealogy",
    "genealogix",
    "specification",
    "documentation"
  ],
  "author": "Oracynth, Inc.",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vitepress": "^2.0.0-alpha.21"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
